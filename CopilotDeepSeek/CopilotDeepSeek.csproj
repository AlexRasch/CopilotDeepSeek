<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>

		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<TrimmerRemoveSymbols Condition="'$(Configuration)' == 'Release'">true</TrimmerRemoveSymbols>
		
		<InvariantGlobalization>true</InvariantGlobalization>
		<PortalRoot>$(MSBuildThisFileDirectory)..\portal</PortalRoot>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CopilotDeepSeekTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CopilotDeepSeek.Database\CopilotDeepSeek.Database.csproj" />
	</ItemGroup>

	<!-- Bygg Vue-portalen och kopiera dist till output -->
	<Target Name="BuildPortal" BeforeTargets="Build" Condition="Exists('$(PortalRoot)\package.json')">
		<Message Text="Building Vue portal..." Importance="high" />
		<Exec Command="npm run build" WorkingDirectory="$(PortalRoot)" />
	</Target>

	<Target Name="CopyPortalOutput" AfterTargets="BuildPortal" Condition="Exists('$(PortalRoot)\dist')">
		<ItemGroup>
			<PortalFiles Include="$(PortalRoot)\dist\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(PortalFiles)" DestinationFiles="@(PortalFiles->'$(OutDir)www\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Message Text="Portal copied to $(OutDir)www\" Importance="high" />
	</Target>

	<Target Name="CopyPortalOutputOnPublish" AfterTargets="Publish" Condition="Exists('$(PortalRoot)\dist')">
		<ItemGroup>
			<PortalFiles Include="$(PortalRoot)\dist\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(PortalFiles)" DestinationFiles="@(PortalFiles->'$(PublishDir)www\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Message Text="Portal copied to $(PublishDir)www\" Importance="high" />
	</Target>

</Project>
